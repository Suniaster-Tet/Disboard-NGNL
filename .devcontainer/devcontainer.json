// =============================================================================
// Disboard-NGNL — configuración del devcontainer
// =============================================================================
{
  "name": "Disboard-NGNL (Elkia)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  "remoteUser": "vscode",
  "containerUser": "vscode",

  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/Disboard-NGNL,type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/Disboard-NGNL",

  "containerEnv": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONUNBUFFERED": "1",
    "CHECKPOINTER_BACKEND": "postgres",
    "PRIVACY_STRICT": "true",
    "SPEECH_INPUT_BACKEND": "local-stt",
    "SPEECH_OUTPUT_BACKEND": "kitten-tts"
  },
  "remoteEnv": {
    // --- Proveedores free tier ---
    "GROQ_API_KEY": "${localEnv:GROQ_API_KEY}",
    "GOOGLE_AI_STUDIO_API_KEY": "${localEnv:GOOGLE_AI_STUDIO_API_KEY}",

    // --- Proveedores de pago (Suniaster solo los usa si Tet autoriza) ---
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "DEEPSEEK_API_KEY": "${localEnv:DEEPSEEK_API_KEY}",

    // --- Jibril (bibliografía) ---
    "CROSSREF_MAILTO": "${localEnv:CROSSREF_MAILTO}",
    "OPENALEX_API_KEY": "${localEnv:OPENALEX_API_KEY}",
    "ORCID_TOKEN": "${localEnv:ORCID_TOKEN}",

    // --- Shiro (Wolfram; pendiente de key) ---
    "WOLFRAM_API_KEY": "${localEnv:WOLFRAM_API_KEY}",

    // --- HITL / Suniaster ---
    "TET_SIGNING_KEY": "${localEnv:TET_SIGNING_KEY}",
    "SUNIASTER_CONFIG": "suniaster/config.yaml",

    // --- Acceso remoto seguro (opcional) ---
    "CLOUDFLARE_TUNNEL_TOKEN": "${localEnv:CLOUDFLARE_TUNNEL_TOKEN}"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "James-Yu.latex-workshop",
        "yzhang.markdown-all-in-one",
        "bierner.markdown-mermaid",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.ruff": "explicit",
          "source.organizeImports.ruff": "explicit"
        },
        "[markdown]": {
          "editor.formatOnSave": false
        }
      }
    }
  },

  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "moby": true
    }
  },

  "postCreateCommand": "bash -lc '[ -f .env ] || cp .env.example .env; mkdir -p logs edges; pip install -e \".[dev]\" || true; pre-commit install || true'",

  "postStartCommand": "bash -lc 'mkdir -p logs edges; docker compose up -d postgres || true'",

  "forwardPorts": [8000, 5432, 8888, 11434],
  "portsAttributes": {
    "8000": {
      "label": "Disboard Web (LangGraph + dashboard)",
      "onAutoForward": "notify"
    },
    "5432": {
      "label": "Postgres (checkpointer)",
      "onAutoForward": "silent"
    },
    "8888": {
      "label": "Jupyter (opcional)",
      "onAutoForward": "silent"
    },
    "11434": {
      "label": "Ollama local (opcional)",
      "onAutoForward": "silent"
    }
  }
}
