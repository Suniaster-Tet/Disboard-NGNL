# =============================================================================
# Disboard-NGNL — .gitignore
# =============================================================================

# Entornos virtuales
.venv/
venv/
ENV/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Variables de entorno y secretos
.env
.env.local
secrets/
*.pem
*.key

# Logs y trazas de ejecución (auditoría local, no versionar)
logs/
!logs/.gitkeep
*.jsonl
graph_trace.jsonl
*.db

# Artefactos y salidas generadas por agentes
artifacts/
out/
dist/
build/
*.egg-info/

# Edges: se versiona contrato, log y semilla; no los artefactos pesados
edges/*
!edges/.gitkeep
!edges/*/
edges/*/artifacts/
edges/*/out/
edges/*/*.pdf
edges/*/*.docx
edges/*/*.xlsx
edges/*/*.parquet
edges/*/*.h5
edges/*/*.tensorial

# IDEs y editores
.vscode/
.idea/
*.swp
.DS_Store

# Cobertura y pruebas
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/

# Antigravity local
.gemini/

# Cloudflare Tunnel (credenciales del túnel)
.cloudflared/
