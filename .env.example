# =============================================================================
# Disboard-NGNL — variables de entorno
# Copiar a .env y completar. NUNCA versionar .env real.
# =============================================================================

# --- Proveedores de IA (Suniaster enruta según suniaster/config.yaml) ---
# Google AI Studio / Gemini API Key (free tier; usada por Shiro y Suniaster)
GOOGLE_AI_STUDIO_API_KEY=tu_clave_google_aqui

# Groq API Key (free tier; proveedor por defecto de Sora, Chlammy, Jibril, Dola)
GROQ_API_KEY=tu_clave_groq_aqui

# OpenAI API Key (pago; Suniaster solo la usa si Tet lo autoriza)
OPENAI_API_KEY=tu_clave_openai_aqui

# Anthropic Claude API Key (pago; Suniaster solo la usa si Tet lo autoriza)
ANTHROPIC_API_KEY=tu_clave_anthropic_aqui

# DeepSeek API Key (pago; Suniaster solo la usa si Tet lo autoriza)
DEEPSEEK_API_KEY=tu_clave_deepseek_aqui

# --- Herramientas científicas (Shiro) ---
# Wolfram AgentOne API Key (cálculos simbólicos).
# Si falta, Suniaster asigna a Shiro un proveedor alternativo y Tet valida.
WOLFRAM_API_KEY=tu_clave_wolfram_aqui

# --- APIs bibliográficas (Jibril) ---
# Crossref polite pool: incluir mailto para límites más altos
CROSSREF_MAILTO=tu_correo@institucion.edu

# OpenAlex: API key gratuita (10x budget diario)
OPENALEX_API_KEY=tu_clave_openalex_aqui

# ORCID: token opcional (solo si se requiere /read-limited; el API público no lo necesita)
ORCID_TOKEN=

# --- Seguridad / HITL ---
# Clave para firma HMAC-SHA256 de las aprobaciones de Tet (consola y web)
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
TET_SIGNING_KEY=genera_una_clave_segura_aqui

# --- Suniaster / Elkia ---
# Ruta al archivo de configuración de enrutamiento de modelos
SUNIASTER_CONFIG=suniaster/config.yaml

# --- Web local (LangGraph + dashboard) ---
# Host y puerto del servidor local (no exponer a 0.0.0.0 sin TLS)
WEB_HOST=127.0.0.1
WEB_PORT=8000

# Checkpointer: "memory" para desarrollo, "postgres" para uso real
CHECKPOINTER_BACKEND=memory
# Solo si CHECKPOINTER_BACKEND=postgres
# POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/disboard

# --- Acceso remoto seguro (opcional) ---
# Token del túnel de Cloudflare (ver docs/manual.md §6.2)
CLOUDFLARE_TUNNEL_TOKEN=

# --- STT/TTS local (opcional) ---
# Backends locales para entrada/salida de voz (ver docs/manual.md)
SPEECH_INPUT_BACKEND=local-stt
SPEECH_OUTPUT_BACKEND=kitten-tts

# --- Privacidad ---
# Si true, Fiel Nirvalen aplica filtrado agresivo antes de cualquier prompt externo
PRIVACY_STRICT=true
